# Port for Express server (Render automatically sets this)
PORT=3000

# MongoDB Connection URI (Atlas or Local)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dsa-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-tracker

# Google OAuth 2.0 Client ID (from Google Cloud Console > APIs & Credentials)
# Example: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Secret key for JWT session cookies (min 32 characters)
JWT_SECRET=dsa_tracker_super_secret_jwt_key_2026_change_in_production
